# Depo koku. Flutter'a ozgu kurallar `app/.gitignore` icinde duruyor;
# burasi yalnizca her yerde gecerli olanlar.

# Makineye ozgu yollar. Android SDK'nin yeri her bilgisayarda farkli;
# repoya girerse baska bir makinede derleme bozulur.
app/android/local.properties

# Isletim sistemi cop dosyalari
.DS_Store
Thumbs.db
desktop.ini

# Derleme ciktilari (app/.gitignore da kapsiyor, burada da duruyor ki
# depo kokunden bakan biri kacirmasin)
build/
.dart_tool/

# APK repoya GIRMEZ. Dagitim GitHub Releases uzerinden yapiliyor;
# 59 MB'lik dosyalari git gecmisine koymak depoyu sisirir ve geri
# alinamaz. Bkz. notlar/KARARLAR.md
*.apk
*.aab

# Yahya'nin yerel calisma defteri. Depo PUBLIC oldugu icin kisisel notlar
# disarida tutuluyor. Ayni kural gidek deposunda da gecerli (PLANLAMA.txt).
# Repoya girmesi isteniyorsa bu satir silinir.
Planlama_MP3.txt

# ============================================================
# IMZA ANAHTARI — ASLA REPOYA GIRMEZ
#
# Bu anahtar kaybolursa ya da sizarsa geri donusu yok:
# - Kaybolursa yeni surum yayinlanamaz (kullanici uygulamayi
#   kaldirip yeniden kurmak zorunda kalir).
# - Sizarsa baskasi bizim uygulamamiz gibi imzali APK uretebilir.
#
# Keystore zaten depo agacinin DISINDA duruyor
# (C:/Users/eavci/AnahtarDeposu/). Bu kurallar ikinci savunma hatti:
# birisi anahtari proje icine kopyalarsa yine de commit'lenmesin.
# ============================================================
*.jks
*.keystore
key.properties

# R8 esleme dosyasi. Obfuscate edilmis cokme raporlarini cozmek icin sart
# ama 10 MB ve her derlemede degisiyor — repoda degil, YAYINLANAN
# SURUMUN yaninda saklanmali (GitHub Release'e ek dosya olarak).
mapping*.txt
