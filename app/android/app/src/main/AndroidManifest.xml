<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ====================================================================
         IZINLER

         INTERNET: Video indirmek ve surum kontrolu icin ZORUNLU.
         DIKKAT — Flutter bu izni yalnizca debug/profile manifestlerine
         koyuyor; RELEASE derlemesine koymuyor. Burada yazili olmazsa
         yayin APK'si internete hic cikamaz ve HATA DA VERMEZ, sadece
         sessizce calismaz. (DevLingo'da tam bu yasandi.)

         REQUEST_INSTALL_PACKAGES: uygulama kendi guncellemesini kurabilsin
         diye. Kullanici ayrica sistemden izin vermek zorunda.
         ==================================================================== -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- Indirilen dosyayi telefonun Muzik / Filmler klasorune cikarmak icin.

         `maxSdkVersion="28"` BILINCLI: Android 10 (API 29) ile gelen
         kapsamli depolamada (scoped storage) uygulama kendi ekledigi
         medyayi MediaStore uzerinden IZINSIZ yazabiliyor. Izni ustunde
         birakmak, yeni telefonlarda kullaniciya gereksiz bir izin sorusu
         cikarir ve uygulamayi oldugundan merakli gosterirdi.

         Android 13'te gelen READ_MEDIA_AUDIO / READ_MEDIA_VIDEO izinleri
         BASKALARININ medyasini okumak icin; biz yalnizca kendi
         dosyalarimizi yazdigimiz icin onlar da gerekmiyor. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>

    <application
        android:label="Medya İndirici"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- PAYLAS MENUSUNDE GORUNMEK

                 Instagram/YouTube "Paylaş" dediginde uygulama listede
                 cikiyor. Paylasilan sey duz metin olarak geliyor: cogu
                 zaman aciklama + link birlikte, o yuzden linki ayiklamak
                 gerekiyor (cekirdek/baglanti.dart).

                 `text/plain` YETIYOR: Instagram ve YouTube gonderiyi
                 metin olarak paylasiyor, dosya olarak degil. `*/*` yazmak
                 uygulamayi her turlu paylasimda (fotograf, PDF, kisi
                 karti) listede gostermek olurdu — indiremeyecegi seyler
                 icin de cikan bir uygulama menuyu kirletir.

                 DIKKAT: Bu filtrenin calismasi yukaridaki
                 `launchMode="singleTop"` ayarina bagli. Olmasaydi her
                 paylasimda uygulamanin ikinci bir kopyasi acilir ve
                 `onNewIntent` hic tetiklenmezdi. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Android 7'den beri baska bir uygulamaya duz dosya yolu verilemiyor;
             dosyanin gecici bir izinle paylasilmasi gerekiyor. Indirdigimiz
             guncelleme APK'sini kurulum ekranina bu saglayici uzerinden
             veriyoruz. Paylasilan klasorler: res/xml/dosya_yollari.xml -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dosyalar"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dosya_yollari" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
